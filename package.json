{
  "name": "cineisle",
  "version": "1.1.0",
  "private": true,
  "description": "映屿 CineIsle：独立维护的影视发现与播放项目，代码基础来源于 LibreTV",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "bun --bun next dev -p 8080",
    "build": "bun --bun next build",
    "start": "bun --bun next start -p 8080",
    "lint": "biome lint --error-on-warnings src scripts",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "check": "bun run lint && bun run typecheck && bun run test",
    "astryx": "bun node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "lint:fix": "biome lint --write src scripts",
    "format": "biome format --write src scripts",
    "format:check": "biome format src scripts",
    "audit": "bun audit --audit-level low",
    "smoke": "bun scripts/smoke.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "artplayer": "^5.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hls.js": "^1.7.4",
    "mediabunny": "^1.66.0",
    "mpegts.js": "^1.8.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ForXd/CineIsle.git"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
